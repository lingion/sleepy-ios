"format_wakeup_json_example" = "{\\n  \"name\": \"My table\",\\n  \"startDate\": \"2026-09-07\",\\n  \"courses\": [\\n    {\"name\":\"Calculus\",\"teacher\":\"John\",\"position\":\"A101\",\"day\":1,\"startNode\":1,\"step\":2,\"startWeek\":1,\"endWeek\":16,\"type\":0}\\n  ]\\n}";
"format_ics_when" = "Calendar files (.ics) exported from your school system or WakeUp. Pick the file via \"Import from file\", or open it in a text editor and paste everything.";
"format_ics_example" = "BEGIN:VCALENDAR\\nBEGIN:VEVENT\\nSUMMARY:Calculus\\nLOCATION:A101\\nDESCRIPTION:第1 - 2节\\\\nA101\\\\nJohn\\nDTSTART:20260907T010000Z\\nDTEND:20260907T015500Z\\nRRULE:FREQ=WEEKLY;UNTIL=20261227T010000Z\\nEND:VEVENT\\nEND:VCALENDAR";
"format_csv_when" = "Registry-exported tables, or Excel files saved as \"CSV (comma delimited)\".";
"format_csv_example" = "course,teacher,room,weekday,period,weeks,type\\nCalculus,John,A101,Monday,1-2,1-16,weekly\\nEnglish,Mary,B202,3,3-4,1-16,odd";
"format_html_when" = "Timetable web pages saved as .html, or copied table source.";
"format_html_example" = "<table>\\n<tr><td>course</td><td>teacher</td><td>room</td><td>weekday</td><td>period</td><td>weeks</td></tr>\\n<tr><td>Calculus</td><td>John</td><td>A101</td><td>1</td><td>1-2</td><td>1-16</td></tr>\\n</table>";
"format_plain_when" = "The most flexible format: one line per class session. Good for typing by hand, even better for AI-generated text from screenshots (see the prompt below).";
"format_plain_example" = "<<<SLEEPY-BEGIN>>>\\n第1节 08:00-09:35\\n第2节 09:55-11:30\\n第3节 13:30-15:05\\nCalculus\\tJohn\\tA101\\t1\\t1-2\\t1-16\\t0\\nEnglish\\tMary\\tB202\\t3\\t3-4\\t1-16\\t1\\nPE\\t-\\t-\\t5\\t3\\t1-16\\t2\\n<<<SLEEPY-END>>>";
"format_wakeup_share_spec_0" = "Copy the whole share text, including the 【来自WakeUp课程表】 header line";
"format_wakeup_share_spec_1" = "The text must contain a courseDetailJson field (WakeUp adds it automatically)";
"format_wakeup_share_spec_2" = "Table name, semester start date and per-course colors are imported too";
"format_wakeup_json_spec_0" = "The whole text must be JSON: starts with { and contains a courses array";
"format_wakeup_json_spec_1" = "Top level: name (table name), startDate (2026-09-07 format)";
"format_wakeup_json_spec_2" = "Each course: name, teacher, position (room), day (number 1-7, 1=Monday), startNode (first period), step (how many periods), startWeek/endWeek range, type (0 weekly / 1 odd / 2 even)";
"format_wakeup_json_spec_3" = "Periods 3-4 = startNode 3, step 2 (not 3 and 4)";
"format_wakeup_json_spec_4" = "color is optional";
"format_ics_spec_0" = "Text must start with BEGIN:VCALENDAR — dropping the first line breaks recognition";
"format_ics_spec_1" = "Each class is one event: SUMMARY = course name, LOCATION = room; teacher is read from the description";
"format_ics_spec_2" = "Weekday is derived from the event date; week 1 = the Monday of the earliest event's week";
"format_ics_spec_3" = "Periods are read from the \"第X - Y节\" line in the description, or estimated from start/end times";
"format_ics_spec_4" = "Biweekly events are merged automatically";
"format_csv_spec_0" = "First line must be a header containing: a course column (course/name) + a teacher column (teacher) + a weekday or weeks column — without the teacher column it won't be detected as CSV; if your table lacks teacher data, add an empty \"teacher\" header column yourself";
"format_csv_spec_1" = "Required columns: course, weekday, weeks, period; optional: teacher, room, type, note";
"format_csv_spec_2" = "Period: a single \"1-2\" column, or separate start/end period columns";
"format_csv_spec_3" = "Weekday accepts 1-7, Monday, or Mon";
"format_csv_spec_4" = "Weeks accepts 1-16, 2-5,7-9, 11,13,15 — ranges become multiple courses";
"format_csv_spec_5" = "Optional \"start time\"/\"end time\" columns (HH:mm): real period times are applied automatically on import";
"format_csv_spec_6" = "Type accepts 0/1/2 or weekly/odd/even";
"format_html_spec_0" = "Text must start with a tag like <!DOCTYPE, <html or <table — leading plain text breaks recognition, remove it first";
"format_html_spec_1" = "The page must contain a table whose header row mentions the course column";
"format_html_spec_2" = "Column names are the same as CSV: course, weekday, period, weeks required; teacher, room, type, note optional";
"format_html_spec_3" = "Same as CSV: optional start/end time columns, applied automatically on import";
"format_html_spec_4" = "Mon-Sun grid layouts don't parse; a long \"one course per row\" table is needed";
"format_plain_spec_0" = "Fixed column order: course, teacher, room, weekday, period, weeks, type (last column optional, defaults to weekly)";
"format_plain_spec_1" = "Separate columns with tab, spaces, or full-width comma";
"format_plain_spec_2" = "Weekday must be a number 1-7 (1=Monday); \"Monday\" won't parse";
"format_plain_spec_3" = "Period as a range: 1-2; single period is just the number: 3";
"format_plain_spec_4" = "Weeks as a range: 1-16";
"format_plain_spec_5" = "Type as a number: 0=weekly 1=odd 2=even";
"format_plain_spec_6" = "Use - for missing teacher or room; lines starting with # are ignored";
"format_plain_spec_7" = "No spaces inside course names, or the line is dropped";
"format_plain_spec_8" = "If the source has a period-time table, output one line per period before the course lines: PeriodN HH:mm HH:mm — real times are applied automatically on import";
"format_plain_spec_9" = "Pasting AI output with chit-chat around it is fine: wrap the data in <<<SLEEPY-BEGIN>>> and <<<SLEEPY-END>>> — anything outside the markers is ignored";

